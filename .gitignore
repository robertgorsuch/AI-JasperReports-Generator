# Compiled / generated artifacts (regenerable)
*.class
*.jasper
__pycache__/

# Microsoft Office owner-lock temp files (created while a doc is open)
~$*

# Large regenerable data exports (rebuild from the DB)
output/

# Dashboard compose / resource export zips (regenerated by the jasper-deploy
# compose/export scripts and the wizard)
report/**/dashboard_model.zip
report/**/*_export.zip

# Report-verification PDFs (re-run reports to regenerate)
out_verify/
out/

# Vendor docs: full JasperReports Server 10.0.0 PDF set (~62 MB, machine-local,
# freely re-downloadable from Jaspersoft). Referenced by the jasper-deploy skill
# but kept out of the repo like the jasperreports-lib jars.
docs/

# jasper-wizard webapp build artifacts (regenerated by build.ps1)
webapp/jasper-wizard/build/
webapp/jasper-wizard/target/
webapp/jasper-wizard/work/

# Secrets — service-account keys / credentials (must never be committed)
sa.json
*.sa.json
*-sa.json

# Load / job logs (regenerated on each run)
*.log

# Notes:
#  - JasperReports runtime (C:\Users\rgorsuch\jasperreports-lib) and source
#    (C:\Users\rgorsuch\jasperreports-7.0.6) live outside this repo by design.
#  - TIGER staging data lives in C:\gisdata (not tracked).
