		<element kind="textField" x="357" y="0" width="217" height="13" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00"><expression><![CDATA[$F{unit_sales}]]></expression></element>
		<element kind="textField" x="580" y="0" width="216" height="13" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00"><expression><![CDATA[$F{total_sales}]]></expression></element>
