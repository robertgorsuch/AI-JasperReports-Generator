		<element kind="staticText" x="580" y="0" width="216" height="18" fontSize="9.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Total Sales]]></text></element>
	</columnHeader>

	<detail>
