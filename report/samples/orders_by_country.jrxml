		<element kind="staticText" x="435" y="0" width="114" height="18" fontSize="9.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Avg Freight]]></text></element>
	</columnHeader>

	<detail>
