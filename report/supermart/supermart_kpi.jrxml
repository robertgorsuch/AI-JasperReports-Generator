<!-- Generated by jasper-deploy scaffold_jrxml.py. JR7-native (JasperReports 7.0.6). -->
<jasperReport name="supermart_kpi" language="java" pageWidth="842" pageHeight="595" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<query language="SQL"><![CDATA[
SELECT round(sum(store_sales), 0)::numeric            AS total_sales,
       round(sum(store_sales - store_cost), 0)::numeric AS gross_profit,
       round(100.0 * sum(store_sales - store_cost) / nullif(sum(store_sales), 0), 1)::numeric AS margin_pct,
       sum(unit_sales)::int                          AS units_sold,
       count(*)::int                                 AS transactions
FROM sales_fact_1997
	]]></query>

	<field name="total_sales" class="java.math.BigDecimal"/>
	<field name="gross_profit" class="java.math.BigDecimal"/>
	<field name="margin_pct" class="java.math.BigDecimal"/>
	<field name="units_sold" class="java.lang.Integer"/>
	<field name="transactions" class="java.lang.Integer"/>

