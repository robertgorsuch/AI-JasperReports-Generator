<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by jasper-deploy scaffold_jrxml.py. JR7-native (JasperReports 7.0.6). -->
<jasperReport name="supermart_sales_by_state" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<query language="SQL"><![CDATA[
SELECT st.store_state                          AS state,
       round(sum(s.store_sales), 0)::numeric   AS sales
FROM sales_fact_1997 s
JOIN store st ON st.store_id = s.store_id
GROUP BY st.store_state
ORDER BY sales DESC
	]]></query>

	<field name="state" class="java.lang.String"/>
	<field name="sales" class="java.math.BigDecimal"/>

	<title height="44">
		<element kind="staticText" x="0" y="0" width="555" height="24" fontSize="16.0" bold="true" forecolor="#000000"><text><![CDATA[Sales by State]]></text></element>
		<element kind="staticText" x="0" y="26" width="555" height="14" fontSize="9.0" forecolor="#666666"><text><![CDATA[Store-sales distribution by state]]></text></element>
	</title>

	<columnHeader height="18">
		<element kind="rectangle" x="0" y="0" width="555" height="18" mode="Opaque" backcolor="#34495E" forecolor="#34495E"/>
		<element kind="staticText" x="6" y="0" width="336" height="18" fontSize="9.0" bold="true" forecolor="#FFFFFF" vTextAlign="Middle"><text><![CDATA[State]]></text></element>
		<element kind="staticText" x="342" y="0" width="207" height="18" fontSize="9.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Sales]]></text></element>
	</columnHeader>

	<detail>
		<band height="13">
		<element kind="textField" x="6" y="0" width="336" height="13" fontSize="8.0" vTextAlign="Middle"><expression><![CDATA[$F{state}]]></expression></element>
		<element kind="textField" x="342" y="0" width="207" height="13" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00"><expression><![CDATA[$F{sales}]]></expression></element>
			<element kind="line" x="0" y="12" width="555" height="1" forecolor="#EEEEEE"/>
		</band>
	</detail>

	<pageFooter height="16">
		<element kind="staticText" x="0" y="2" width="277" height="12" fontSize="8.0" forecolor="#666666"><text><![CDATA[Sales by State]]></text></element>
		<element kind="textField" x="400" y="2" width="120" height="12" forecolor="#666666" fontSize="8.0" hTextAlign="Right"><expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></expression></element>
		<element kind="textField" x="522" y="2" width="33" height="12" forecolor="#666666" fontSize="8.0" evaluationTime="Report"><expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression></element>
	</pageFooter>

	<summary height="382">
		<element kind="chart" chartType="bar" x="0" y="10" width="555" height="360" evaluationTime="Report">
			<dataset kind="category">
				<series>
					<seriesExpression><![CDATA["Sales"]]></seriesExpression>
					<categoryExpression><![CDATA[$F{state}]]></categoryExpression>
					<valueExpression><![CDATA[$F{sales}]]></valueExpression>
				</series>
			</dataset>
			<plot showTickMarks="true" showTickLabels="true"/>
		</element>
	</summary>

</jasperReport>
