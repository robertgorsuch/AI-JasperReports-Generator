	</columnHeader>

	<detail>
		<band height="13">
		<element kind="textField" x="6" y="0" width="100" height="13" fontSize="8.0" vTextAlign="Middle"><expression><![CDATA[$F{dashboard_uri}]]></expression></element>
		<element kind="textField" x="112" y="0" width="100" height="13" fontSize="8.0" vTextAlign="Middle"><expression><![CDATA[$F{label}]]></expression></element>
