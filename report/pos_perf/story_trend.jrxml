<?xml version="1.0" encoding="UTF-8"?>
<!-- Option C (Promo & Margin Story): wide monthly Net Sales trend, Jan 2019 -
     Dec 2020, with three point annotations (Dec 2019 / Mar 2020 / Dec 2020).

     Per exec_trend.jrxml's precedent: no JFreeChart interval-marker customizer
     class exists for shading the pandemic period on a line chart (only
     GradientTrendCustomizer, which is bar-chart-specific per gotcha G7), and
     building + deploying a new customizer jar means rebuilding
     actian-chart-customizers.jar and restarting Tomcat on shared STAGE,
     out of scope. This report ships the same safe fallback: a plain brand
     line chart plus a labeled callout row with three annotation panels
     (matching exec_kpi_strip's divider-line layout) instead of an in-plot
     shaded region. All three callout values are computed by SQL scalar
     subqueries (repeated per output row, picked up via evaluationTime="Report"
     against the last row, same value on every row since the subqueries are
     non-correlated) rather than hardcoded, so they self-verify against live
     data. JR7-native. -->
<jasperReport name="story_trend" language="java" pageWidth="1600" pageHeight="420" columnWidth="1580" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10">
	<query language="SQL"><![CDATA[
SELECT m.yr AS yr, m.mo AS mo, SUM(m.sales_ext) AS v,
       (SELECT SUM(sales_ext) FROM dash_monthly WHERE yr = 2019 AND mo = 12) AS dec19,
       (SELECT SUM(sales_ext) FROM dash_monthly WHERE yr = 2020 AND mo = 12) AS dec20,
       (SELECT SUM(sales_ext) FROM dash_monthly WHERE yr = 2020 AND mo = 3) AS mar20,
       (SELECT SUM(sales_ext) FROM dash_monthly WHERE yr = 2020 AND mo = 2) AS feb20
FROM dash_monthly m
GROUP BY m.yr, m.mo
ORDER BY 1, 2
	]]></query>

	<field name="yr" class="java.lang.Integer"/>
	<field name="mo" class="java.lang.Integer"/>
	<field name="v" class="java.math.BigDecimal"/>
	<field name="dec19" class="java.math.BigDecimal"/>
	<field name="dec20" class="java.math.BigDecimal"/>
	<field name="mar20" class="java.math.BigDecimal"/>
	<field name="feb20" class="java.math.BigDecimal"/>

	<title height="60">
		<element kind="image" x="0" y="4" width="36" height="36" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Top"><expression><![CDATA["repo:/images/actian_logo"]]></expression></element>
		<element kind="staticText" x="0" y="4" width="1580" height="26" fontSize="16.0" bold="true" forecolor="#1F4E79" hTextAlign="Center"><text><![CDATA[Monthly Net Sales Trend]]></text></element>
		<element kind="staticText" x="0" y="32" width="1580" height="16" fontSize="9.5" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Jan 2019 - Dec 2020 -- pandemic period: Mar 2020 onward (see callouts below)]]></text></element>
	</title>

	<summary height="340">
		<element kind="chart" chartType="line" x="0" y="0" width="1580" height="230" evaluationTime="Report">
			<dataset kind="category">
				<series>
					<seriesExpression><![CDATA["Net Sales"]]></seriesExpression>
					<categoryExpression><![CDATA[$F{yr} + "-" + ($F{mo} < 10 ? "0" + $F{mo} : "" + $F{mo})]]></categoryExpression>
					<valueExpression><![CDATA[$F{v}]]></valueExpression>
				</series>
			</dataset>
			<plot showLines="true" showShapes="true" categoryAxisTickLabelRotation="-45">
				<seriesColor order="0" color="#0550DC"/>
			</plot>
		</element>

		<element kind="line" x="526" y="245" width="1" height="70" forecolor="#D6E0EF"/>
		<element kind="line" x="1053" y="245" width="1" height="70" forecolor="#D6E0EF"/>

		<element kind="staticText" x="0" y="242" width="526" height="18" fontSize="11.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Dec 2019]]></text></element>
		<element kind="textField" x="0" y="262" width="526" height="32" fontSize="19.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle" evaluationTime="Report">
			<expression><![CDATA["$" + new java.text.DecimalFormat("#,##0.0").format($F{dec19}.doubleValue() / 1000000.0) + "M"]]></expression>
		</element>

		<element kind="staticText" x="537" y="242" width="516" height="18" fontSize="11.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Mar 2020 (pandemic onset)]]></text></element>
		<element kind="textField" x="537" y="262" width="516" height="32" fontSize="19.0" bold="true" forecolor="#D9534F" hTextAlign="Center" vTextAlign="Middle" evaluationTime="Report">
			<expression><![CDATA[new java.text.DecimalFormat("+#,##0;-#,##0").format(($F{mar20}.doubleValue() - $F{feb20}.doubleValue()) / $F{feb20}.doubleValue() * 100) + "% MoM"]]></expression>
		</element>

		<element kind="staticText" x="1064" y="242" width="516" height="18" fontSize="11.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Dec 2020 (best month)]]></text></element>
		<element kind="textField" x="1064" y="262" width="516" height="32" fontSize="19.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle" evaluationTime="Report">
			<expression><![CDATA["$" + new java.text.DecimalFormat("#,##0.0").format($F{dec20}.doubleValue() / 1000000.0) + "M"]]></expression>
		</element>
	</summary>

</jasperReport>
