<?xml version="1.0" encoding="UTF-8"?>
<!-- Executive Overview: Top 6 stores by net sales. Ranked table pattern mirrors
     foodmart/top_5_products.jrxml ($V{REPORT_COUNT} rank column, header band,
     divider lines). JR7-native. -->
<jasperReport name="exec_top_stores" language="java" pageWidth="800" pageHeight="214" columnWidth="780" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10">
	<query language="SQL"><![CDATA[
SELECT storename, storeregion, sales_ext FROM dash_store ORDER BY sales_ext DESC FETCH FIRST 6 ROWS ONLY
	]]></query>

	<field name="storename" class="java.lang.String"/>
	<field name="storeregion" class="java.lang.String"/>
	<field name="sales_ext" class="java.math.BigDecimal"/>

	<title height="52">
		<element kind="image" x="0" y="0" width="44" height="44" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Top"><expression><![CDATA["repo:/images/actian_logo"]]></expression></element>
		<element kind="staticText" x="0" y="0" width="780" height="24" fontSize="16.0" bold="true" forecolor="#1F4E79" hTextAlign="Center"><text><![CDATA[Top 6 Stores by Net Sales]]></text></element>
		<element kind="staticText" x="0" y="26" width="780" height="14" fontSize="9.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Highest-performing store locations]]></text></element>
	</title>

	<columnHeader height="22">
		<element kind="rectangle" x="0" y="0" width="780" height="22" mode="Opaque" backcolor="#1F4E79" forecolor="#1F4E79"/>
		<element kind="staticText" x="6" y="0" width="34" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[#]]></text></element>
		<element kind="staticText" x="46" y="0" width="330" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" vTextAlign="Middle"><text><![CDATA[Store]]></text></element>
		<element kind="staticText" x="380" y="0" width="200" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" vTextAlign="Middle"><text><![CDATA[Region]]></text></element>
		<element kind="staticText" x="586" y="0" width="188" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Net Sales]]></text></element>
	</columnHeader>

	<detail>
		<band height="24">
		<element kind="textField" x="6" y="0" width="34" height="20" fontSize="10.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$V{REPORT_COUNT}]]></expression></element>
		<element kind="textField" x="46" y="0" width="330" height="20" fontSize="10.0" vTextAlign="Middle"><expression><![CDATA[$F{storename}]]></expression></element>
		<element kind="textField" x="380" y="0" width="200" height="20" fontSize="10.0" vTextAlign="Middle"><expression><![CDATA[$F{storeregion}]]></expression></element>
		<element kind="textField" x="586" y="0" width="188" height="20" fontSize="10.0" hTextAlign="Right" vTextAlign="Middle" pattern="$#,##0"><expression><![CDATA[$F{sales_ext}]]></expression></element>
			<element kind="line" x="0" y="23" width="780" height="1" forecolor="#D6E0EF"/>
		</band>
	</detail>

</jasperReport>
