<?xml version="1.0" encoding="UTF-8"?>
<!-- Executive Overview: 5-up KPI strip (Net Sales / Transactions / Quantity /
     Avg Basket / Stores). Pattern mirrors foodmart/kpi_strip.jrxml (divider
     lines, evaluationTime="Report"). JR7-native. -->
<jasperReport name="exec_kpi_strip" language="java" pageWidth="1600" pageHeight="130" columnWidth="1580" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10">
	<query language="SQL"><![CDATA[SELECT sales_ext, tx, qty, sales_ext/NULLIF(tx,0) AS basket, 330 AS stores FROM dash_kpi]]></query>

	<field name="sales_ext" class="java.math.BigDecimal"/>
	<field name="tx" class="java.lang.Long"/>
	<field name="qty" class="java.lang.Long"/>
	<field name="basket" class="java.math.BigDecimal"/>
	<field name="stores" class="java.lang.Integer"/>

	<title height="110">
		<element kind="staticText" x="0" y="14" width="316" height="26" fontSize="13.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Net Sales]]></text></element>
		<element kind="textField" x="0" y="44" width="316" height="50" fontSize="26.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle" pattern="$#,##0" evaluationTime="Report"><expression><![CDATA[$F{sales_ext}]]></expression></element>

		<element kind="line" x="316" y="20" width="1" height="70" forecolor="#D6E0EF"/>
		<element kind="staticText" x="316" y="14" width="316" height="26" fontSize="13.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Transactions]]></text></element>
		<element kind="textField" x="316" y="44" width="316" height="50" fontSize="26.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle" pattern="#,##0" evaluationTime="Report"><expression><![CDATA[$F{tx}]]></expression></element>

		<element kind="line" x="632" y="20" width="1" height="70" forecolor="#D6E0EF"/>
		<element kind="staticText" x="632" y="14" width="316" height="26" fontSize="13.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Quantity Sold]]></text></element>
		<element kind="textField" x="632" y="44" width="316" height="50" fontSize="26.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle" pattern="#,##0" evaluationTime="Report"><expression><![CDATA[$F{qty}]]></expression></element>

		<element kind="line" x="948" y="20" width="1" height="70" forecolor="#D6E0EF"/>
		<element kind="staticText" x="948" y="14" width="316" height="26" fontSize="13.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Avg Basket]]></text></element>
		<element kind="textField" x="948" y="44" width="316" height="50" fontSize="26.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle" pattern="$#,##0.00" evaluationTime="Report"><expression><![CDATA[$F{basket}]]></expression></element>

		<element kind="line" x="1264" y="20" width="1" height="70" forecolor="#D6E0EF"/>
		<element kind="staticText" x="1264" y="14" width="316" height="26" fontSize="13.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Stores]]></text></element>
		<element kind="textField" x="1264" y="44" width="316" height="50" fontSize="26.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle" pattern="#,##0" evaluationTime="Report"><expression><![CDATA[$F{stores}]]></expression></element>
	</title>

</jasperReport>
