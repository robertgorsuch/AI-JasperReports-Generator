<?xml version="1.0" encoding="UTF-8"?>
<!-- Gross margin KPI dial (JFreeChart meter). Compact, square element -> perfect
     circle. Sized to stack in the dashboard dial column. JR7-native. -->
<jasperReport name="gross_margin_dial" language="java" pageWidth="400" pageHeight="260" columnWidth="384" leftMargin="8" rightMargin="8" topMargin="8" bottomMargin="8">
	<query language="SQL"><![CDATA[SELECT round((SUM(store_sales - store_cost) / SUM(store_sales) * 100)::numeric, 1) AS gross_margin FROM sales_fact_1998]]></query>

	<field name="gross_margin" class="java.math.BigDecimal"/>

	<title height="244">
		<element kind="staticText" x="0" y="0" width="384" height="20" fontSize="12.0" bold="true" forecolor="#1F4E79" hTextAlign="Center"><text><![CDATA[Gross Margin (2026)]]></text></element>

		<element kind="chart" chartType="meter" x="82" y="24" width="220" height="220" evaluationTime="Report">
			<dataset kind="value">
				<valueExpression><![CDATA[$F{gross_margin}]]></valueExpression>
			</dataset>
			<plot shape="dial" units="%" tickCount="11" meterAngle="180" needleColor="#1F4E79" tickColor="#5B7DA6">
				<dataRange>
					<lowExpression><![CDATA[Double.valueOf(0)]]></lowExpression>
					<highExpression><![CDATA[Double.valueOf(100)]]></highExpression>
				</dataRange>
				<valueDisplay color="#1F4E79" mask="#,##0.0'%'"/>
				<interval label="Poor" backgroundColor="#D9534F">
					<dataRange>
						<lowExpression><![CDATA[Double.valueOf(0)]]></lowExpression>
						<highExpression><![CDATA[Double.valueOf(40)]]></highExpression>
					</dataRange>
				</interval>
				<interval label="Fair" backgroundColor="#F0AD4E">
					<dataRange>
						<lowExpression><![CDATA[Double.valueOf(40)]]></lowExpression>
						<highExpression><![CDATA[Double.valueOf(60)]]></highExpression>
					</dataRange>
				</interval>
				<interval label="Good" backgroundColor="#5CB85C">
					<dataRange>
						<lowExpression><![CDATA[Double.valueOf(60)]]></lowExpression>
						<highExpression><![CDATA[Double.valueOf(100)]]></highExpression>
					</dataRange>
				</interval>
			</plot>
		</element>

		<element kind="textField" x="82" y="150" width="220" height="24" fontSize="16.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle" evaluationTime="Report"><expression><![CDATA[new java.text.DecimalFormat("#,##0.0").format($F{gross_margin}) + "%"]]></expression></element>
	</title>

</jasperReport>
