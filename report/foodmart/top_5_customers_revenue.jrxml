<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by jasper-deploy scaffold_jrxml.py. JR7-native (JasperReports 7.0.6). -->
<jasperReport name="top_5_customers_revenue" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<query language="SQL"><![CDATA[
SELECT c.customer_id, c.fname || ' ' || c.lname AS customer_name, SUM(s.store_sales)::bigint AS revenue FROM sales_fact_1997 s JOIN customer c ON c.customer_id = s.customer_id GROUP BY 1, 2 ORDER BY 3 DESC LIMIT 5
	]]></query>

	<field name="customer_id" class="java.lang.Integer"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="revenue" class="java.lang.Long"/>

	<title height="44">
		<element kind="staticText" x="0" y="0" width="555" height="24" fontSize="17.0" bold="true" forecolor="#1F4E79"><text><![CDATA[Top 5 Customers]]></text></element>
		<element kind="staticText" x="0" y="26" width="555" height="14" fontSize="9.0" forecolor="#5B7DA6"><text><![CDATA[by Total Revenue]]></text></element>
	</title>

	<columnHeader height="18">
		<element kind="rectangle" x="0" y="0" width="555" height="18" mode="Opaque" backcolor="#1F4E79" forecolor="#1F4E79"/>
		<element kind="staticText" x="0" y="0" width="149" height="18" fontSize="9.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Customer Id]]></text></element>
		<element kind="staticText" x="161" y="0" width="240" height="18" fontSize="9.0" bold="true" forecolor="#FFFFFF" vTextAlign="Middle"><text><![CDATA[Customer Name]]></text></element>
		<element kind="staticText" x="401" y="0" width="148" height="18" fontSize="9.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Revenue]]></text></element>
	</columnHeader>

	<detail>
		<band height="13">
		<element kind="textField" x="0" y="0" width="149" height="13" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0"><expression><![CDATA[$F{customer_id}]]></expression></element>
		<element kind="textField" x="161" y="0" width="240" height="13" fontSize="8.0" vTextAlign="Middle"><expression><![CDATA[$F{customer_name}]]></expression></element>
		<element kind="textField" x="401" y="0" width="148" height="13" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0"><expression><![CDATA[$F{revenue}]]></expression></element>
			<element kind="line" x="0" y="12" width="555" height="1" forecolor="#D6E0EF"/>
		</band>
	</detail>

	<pageFooter height="16">
		<element kind="staticText" x="0" y="2" width="277" height="12" fontSize="8.0" forecolor="#5B7DA6"><text><![CDATA[Top 5 Customers]]></text></element>
		<element kind="textField" x="400" y="2" width="120" height="12" forecolor="#5B7DA6" fontSize="8.0" hTextAlign="Right"><expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></expression></element>
		<element kind="textField" x="522" y="2" width="33" height="12" forecolor="#5B7DA6" fontSize="8.0" evaluationTime="Report"><expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression></element>
	</pageFooter>

	<summary height="322">
		<element kind="chart" chartType="pie" x="0" y="10" width="555" height="300" evaluationTime="Report">
			<dataset kind="pie">
				<series>
					<keyExpression><![CDATA[$F{customer_name}]]></keyExpression>
					<valueExpression><![CDATA[$F{revenue}]]></valueExpression>
				</series>
