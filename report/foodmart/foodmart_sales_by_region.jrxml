<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by jasper-deploy scaffold_jrxml.py. JR7-native (JasperReports 7.0.6). -->
<jasperReport name="foodmart_sales_by_region" language="java" pageWidth="950" pageHeight="422" columnWidth="910" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<query language="SQL"><![CDATA[
SELECT r.sales_region AS region,
       SUM(sf.store_sales)::numeric(12,2) AS sales,
       SUM(sf.unit_sales)::int AS units
FROM sales_fact_1998 sf
JOIN store s ON s.store_id = sf.store_id
JOIN region r ON r.region_id = s.region_id
GROUP BY r.sales_region
ORDER BY sales DESC
	]]></query>

	<field name="region" class="java.lang.String"/>
	<field name="sales" class="java.math.BigDecimal"/>
	<field name="units" class="java.lang.Integer"/>

	<title height="52">
		<element kind="image" x="0" y="0" width="44" height="44" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Top"><expression><![CDATA["repo:/images/actian_logo"]]></expression></element>
		<element kind="staticText" x="0" y="0" width="910" height="24" fontSize="17.0" bold="true" forecolor="#1F4E79" hTextAlign="Center"><text><![CDATA[Sales by Region]]></text></element>
		<element kind="staticText" x="0" y="26" width="910" height="14" fontSize="9.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Store sales by sales region (2026)]]></text></element>
	</title>

<summary height="330">
		<element kind="chart" chartType="pie3D" x="0" y="0" width="910" height="330" evaluationTime="Report">
			<dataset kind="pie">
				<series>
					<keyExpression><![CDATA[$F{region}]]></keyExpression>
					<valueExpression><![CDATA[$F{sales}]]></valueExpression>
					<labelExpression><![CDATA[$F{region} + ": " + new java.text.DecimalFormat("#,##0").format($F{units}) + " units"]]></labelExpression>
				</series>
			</dataset>
			<plot labelFormat="{0}: {2}" legendLabelFormat="{0} ({2})">
				<seriesColor order="0" color="#0A2A4A"/>
				<seriesColor order="1" color="#274665"/>
				<seriesColor order="2" color="#446380"/>
				<seriesColor order="3" color="#617F9B"/>
				<seriesColor order="4" color="#7E9BB6"/>
				<seriesColor order="5" color="#9BB8D1"/>
				<seriesColor order="6" color="#B8D4EC"/>
			</plot>
		</element>
	</summary>

</jasperReport>
