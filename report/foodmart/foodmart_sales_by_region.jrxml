		<element kind="staticText" x="342" y="0" width="207" height="18" fontSize="9.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Sales]]></text></element>
	</columnHeader>

	<detail>
		<band height="13">
		<element kind="textField" x="6" y="0" width="336" height="13" fontSize="8.0" vTextAlign="Middle"><expression><![CDATA[$F{region}]]></expression></element>
		<element kind="textField" x="342" y="0" width="207" height="13" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00"><expression><![CDATA[$F{sales}]]></expression></element>
			<element kind="line" x="0" y="12" width="555" height="1" forecolor="#D6E0EF"/>
		</band>
	</detail>

	<pageFooter height="16">
		<element kind="staticText" x="0" y="2" width="277" height="12" fontSize="8.0" forecolor="#5B7DA6"><text><![CDATA[Foodmart - Sales by Region]]></text></element>
		<element kind="textField" x="400" y="2" width="120" height="12" forecolor="#5B7DA6" fontSize="8.0" hTextAlign="Right"><expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></expression></element>
		<element kind="textField" x="522" y="2" width="33" height="12" forecolor="#5B7DA6" fontSize="8.0" evaluationTime="Report"><expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression></element>
	</pageFooter>

	<summary height="322">
		<element kind="chart" chartType="pie3D" x="0" y="10" width="555" height="300" evaluationTime="Report">
			<dataset kind="pie">
				<series>
					<keyExpression><![CDATA[$F{region}]]></keyExpression>
					<valueExpression><![CDATA[$F{sales}]]></valueExpression>
				</series>
			</dataset>
			<plot labelFormat="{0}: {2}" legendLabelFormat="{0} ({2})">
				<seriesColor order="0" color="#0A2A4A"/>
