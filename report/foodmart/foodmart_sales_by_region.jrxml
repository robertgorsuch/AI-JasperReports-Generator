<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by jasper-deploy scaffold_jrxml.py. JR7-native (JasperReports 7.0.6). -->
<jasperReport name="foodmart_sales_by_region" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<query language="SQL"><![CDATA[
SELECT r.sales_region AS region,
       SUM(sf.store_sales)::numeric(12,2) AS sales
FROM sales_fact_1998 sf
JOIN store s ON s.store_id = sf.store_id
JOIN region r ON r.region_id = s.region_id
GROUP BY r.sales_region
ORDER BY sales DESC
	]]></query>

	<field name="region" class="java.lang.String"/>
	<field name="sales" class="java.math.BigDecimal"/>

	<title height="52">
		<element kind="image" x="0" y="0" width="44" height="44" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Top"><expression><![CDATA["repo:/images/actian_logo"]]></expression></element>
		<element kind="staticText" x="0" y="0" width="555" height="24" fontSize="17.0" bold="true" forecolor="#1F4E79" hTextAlign="Center"><text><![CDATA[Foodmart - Sales by Region]]></text></element>
		<element kind="staticText" x="0" y="26" width="555" height="14" fontSize="9.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Store sales by sales region (1998)]]></text></element>
	</title>

	<columnHeader height="18">
		<element kind="rectangle" x="0" y="0" width="555" height="18" mode="Opaque" backcolor="#1F4E79" forecolor="#1F4E79"/>
