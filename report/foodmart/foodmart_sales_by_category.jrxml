<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by jasper-deploy scaffold_jrxml.py. JR7-native (JasperReports 7.0.6). -->
<jasperReport name="foodmart_sales_by_category" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<query language="SQL"><![CDATA[
SELECT pc.product_category AS category,
       SUM(sf.store_sales)::numeric(12,2) AS sales,
       SUM(sf.unit_sales)::int AS units
FROM sales_fact_1998 sf
JOIN product p ON p.product_id = sf.product_id
JOIN product_class pc ON pc.product_class_id = p.product_class_id
GROUP BY pc.product_category
ORDER BY sales DESC
LIMIT 15
	]]></query>

	<field name="category" class="java.lang.String"/>
	<field name="sales" class="java.math.BigDecimal"/>
	<field name="units" class="java.lang.Integer"/>

	<title height="44">
		<element kind="staticText" x="0" y="0" width="555" height="24" fontSize="17.0" bold="true" forecolor="#1F4E79" hTextAlign="Center"><text><![CDATA[Foodmart - Sales by Product Category]]></text></element>
		<element kind="staticText" x="0" y="26" width="555" height="14" fontSize="9.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Top 15 categories by store sales (1998)]]></text></element>
	</title>

	<columnHeader height="18">
		<element kind="rectangle" x="0" y="0" width="555" height="18" mode="Opaque" backcolor="#1F4E79" forecolor="#1F4E79"/>
