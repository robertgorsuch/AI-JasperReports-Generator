		<element kind="staticText" x="247" y="0" width="148" height="18" fontSize="9.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Sales]]></text></element>
		<element kind="staticText" x="401" y="0" width="148" height="18" fontSize="9.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Units]]></text></element>
	</columnHeader>

	<detail>
		<band height="13">
		<element kind="textField" x="6" y="0" width="241" height="13" fontSize="8.0" vTextAlign="Middle"><expression><![CDATA[$F{category}]]></expression></element>
		<element kind="textField" x="247" y="0" width="148" height="13" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00"><expression><![CDATA[$F{sales}]]></expression></element>
		<element kind="textField" x="401" y="0" width="148" height="13" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0"><expression><![CDATA[$F{units}]]></expression></element>
			<element kind="line" x="0" y="12" width="555" height="1" forecolor="#D6E0EF"/>
		</band>
	</detail>

	<pageFooter height="16">
