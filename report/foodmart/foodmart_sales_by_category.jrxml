		<element kind="textField" x="522" y="2" width="33" height="12" forecolor="#5B7DA6" fontSize="8.0" evaluationTime="Report"><expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression></element>
	</pageFooter>

	<summary height="342">
		<element kind="chart" chartType="bar" x="0" y="10" width="555" height="320" evaluationTime="Report">
