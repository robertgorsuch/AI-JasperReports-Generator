<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by jasper-deploy scaffold_jrxml.py. JR7-native (JasperReports 7.0.6). -->
<jasperReport name="foodmart_sales_by_category" language="java" pageWidth="950" pageHeight="422" columnWidth="910" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<query language="SQL"><![CDATA[
SELECT pc.product_category AS category,
       SUM(sf.store_sales)::numeric(12,2) AS sales,
       SUM(sf.unit_sales)::int AS units
FROM sales_fact_1998 sf
JOIN product p ON p.product_id = sf.product_id
JOIN product_class pc ON pc.product_class_id = p.product_class_id
GROUP BY pc.product_category
ORDER BY sales DESC
LIMIT 15
	]]></query>

	<field name="category" class="java.lang.String"/>
	<field name="sales" class="java.math.BigDecimal"/>
	<field name="units" class="java.lang.Integer"/>

	<title height="52">
		<element kind="image" x="0" y="0" width="44" height="44" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Top"><expression><![CDATA["repo:/images/actian_logo"]]></expression></element>
		<element kind="staticText" x="0" y="0" width="910" height="24" fontSize="17.0" bold="true" forecolor="#1F4E79" hTextAlign="Center"><text><![CDATA[Sales by Product Category]]></text></element>
		<element kind="staticText" x="0" y="26" width="910" height="14" fontSize="9.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Top 15 categories by store sales (2026)]]></text></element>
	</title>

<summary height="330">
		<element kind="chart" chartType="bar" x="0" y="0" width="910" height="330" evaluationTime="Report" customizerClass="com.actian.jasper.GradientTrendCustomizer">
			<dataset kind="category">
				<series>
					<seriesExpression><![CDATA["Sales"]]></seriesExpression>
					<categoryExpression><![CDATA[$F{category}]]></categoryExpression>
					<valueExpression><![CDATA[$F{sales}]]></valueExpression>
				</series>
				<series>
					<seriesExpression><![CDATA["Units"]]></seriesExpression>
					<categoryExpression><![CDATA[$F{category}]]></categoryExpression>
					<valueExpression><![CDATA[$F{units}]]></valueExpression>
				</series>
			</dataset>
			<plot showTickMarks="true" showTickLabels="true" categoryAxisTickLabelRotation="-45"/>
		</element>
	</summary>

</jasperReport>
