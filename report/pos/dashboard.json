{
  "db": "db",
  "dataSourceUri": "/datasources/pos_actian",
  "folder": "/reports/pos",
  "name": "pos_comprehensive_dashboard",
  "label": "POS Comprehensive Analysis Dashboard",
  "outDir": "report/pos",
  "cols": 2,
  "dashlets": [
    {
      "name": "pos_kpi_summary",
      "title": "KPI Summary",
      "kind": "report",
      "queryFile": "report/pos/kpi_summary.sql",
      "x": 0,
      "y": 0,
      "width": 40,
      "height": 6
    },
    {
      "name": "pos_sales_by_store",
      "title": "Sales by Store (Top Performers)",
      "kind": "report",
      "queryFile": "report/pos/sales_by_store.sql",
      "chart": "bar",
      "chartCategory": "store_name",
      "chartValue": "total_sales",
      "chartHeight": 400,
      "landscape": true,
      "x": 0,
      "y": 6,
      "width": 20,
      "height": 10
    },
    {
      "name": "pos_sales_by_product",
      "title": "Top 15 Products by Sales",
      "kind": "report",
      "queryFile": "report/pos/sales_by_product.sql",
      "chart": "bar",
      "chartCategory": "product_description",
      "chartValue": "total_sales",
      "chartHeight": 400,
      "landscape": true,
      "x": 20,
      "y": 6,
      "width": 20,
      "height": 10
    },
    {
      "name": "pos_daily_sales_trend",
      "title": "Daily Sales Trend",
      "kind": "report",
      "queryFile": "report/pos/daily_sales_trend.sql",
      "chart": "line",
      "chartCategory": "transaction_date",
      "chartValue": "daily_sales",
      "chartHeight": 300,
      "landscape": true,
      "x": 0,
      "y": 16,
      "width": 40,
      "height": 10
    },
    {
      "name": "pos_hourly_analysis",
      "title": "Peak Hours Analysis",
      "kind": "report",
      "queryFile": "report/pos/hourly_analysis.sql",
      "chart": "bar",
      "chartCategory": "hour_of_day",
      "chartValue": "hourly_sales",
      "chartHeight": 350,
      "x": 0,
      "y": 26,
      "width": 20,
      "height": 10
    },
    {
      "name": "pos_loyalty_analysis",
      "title": "Loyalty vs Non-Loyalty Customers",
      "kind": "report",
      "queryFile": "report/pos/loyalty_analysis.sql",
      "chart": "pie",
      "chartCategory": "customer_type",
      "chartValue": "total_sales",
      "chartHeight": 350,
      "x": 20,
      "y": 26,
      "width": 20,
      "height": 10
    },
    {
      "name": "pos_promotion_analysis",
      "title": "Promotion Effectiveness",
      "kind": "report",
      "queryFile": "report/pos/promotion_analysis.sql",
      "chart": "bar",
      "chartCategory": "promotion_type",
      "chartValue": "total_sales",
      "chartHeight": 350,
      "x": 0,
      "y": 36,
      "width": 20,
      "height": 10
    },
    {
      "name": "pos_returns_voids_analysis",
      "title": "Returns & Voids Impact",
      "kind": "report",
      "queryFile": "report/pos/returns_voids_analysis.sql",
      "chart": "bar",
      "chartCategory": "transaction_category",
      "chartValue": "impact",
      "chartHeight": 350,
      "x": 20,
      "y": 36,
      "width": 20,
      "height": 10
    },
    {
      "name": "pos_weekly_pattern",
      "title": "Weekly Pattern (Day of Week)",
      "kind": "report",
      "queryFile": "report/pos/weekly_pattern.sql",
      "chart": "bar",
      "chartCategory": "day_name",
      "chartValue": "daily_sales",
      "chartHeight": 350,
      "x": 0,
      "y": 46,
      "width": 40,
      "height": 10
    }
  ]
}
