<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="customer_payment" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<query language="SQL"><![CDATA[
SELECT 
  customer_id,
  payment_method,
  usage_count
FROM dashboard_customer_payment
ORDER BY usage_count DESC
FETCH FIRST 25 ROWS ONLY
	]]></query>

	<field name="customer_id" class="java.lang.String"/>
	<field name="payment_method" class="java.lang.String"/>

	<title height="44">
		<element kind="staticText" x="0" y="0" width="555" height="24" fontSize="16.0" bold="true" hTextAlign="Center"><text><![CDATA[Customer Payment Methods]]></text></element>
	</title>

	<columnHeader height="18">
		<element kind="rectangle" x="0" y="0" width="555" height="18" mode="Opaque" backcolor="#34495E" forecolor="#34495E"/>
		<element kind="staticText" x="0" y="0" width="277" height="18" fontSize="9.0" bold="true" vTextAlign="Middle"><text><![CDATA[Customer ID]]></text></element>
		<element kind="staticText" x="277" y="0" width="277" height="18" fontSize="9.0" bold="true" vTextAlign="Middle"><text><![CDATA[Payment Method]]></text></element>
	</columnHeader>

	<detail>
		<band height="13">
			<element kind="textField" x="0" y="0" width="277" height="13" fontSize="8.0" vTextAlign="Middle"><expression><![CDATA[$F{customer_id}]]></expression></element>
		<element kind="textField" x="277" y="0" width="277" height="13" fontSize="8.0" vTextAlign="Middle"><expression><![CDATA[$F{payment_method}]]></expression></element>
			<element kind="line" x="0" y="12" width="555" height="1" forecolor="#EEEEEE"/>
		</band>
	</detail>

	<pageFooter height="16">
		<element kind="textField" x="400" y="2" width="120" height="12" forecolor="#666666" fontSize="8.0" hTextAlign="Right"><expression><![CDATA["Page " + $V{PAGE_NUMBER}]]></expression></element>
	</pageFooter>

</jasperReport>