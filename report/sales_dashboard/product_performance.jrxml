<jasperReport name="product_performance" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<query language="SQL"><![CDATA[
SELECT
  plu,
  product_description,
  units_sold
FROM dashboard_product_performance
ORDER BY units_sold DESC
FETCH FIRST 20 ROWS ONLY
	]]></query>

	<field name="plu" class="java.lang.Integer"/>
	<field name="product_description" class="java.lang.String"/>
	<field name="units_sold" class="java.math.BigDecimal"/>

