  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set default values if not already set",
          "if (!pm.environment.get('base_url')) {",
          "  pm.environment.set('base_url', 'http://localhost:8081/jasperserver-pro');",
          "}",
          "if (!pm.environment.get('username')) {",
          "  pm.environment.set('username', 'superuser');",
          "}",
          "if (!pm.environment.get('password')) {",
          "  pm.environment.set('password', 'superuser');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081/jasperserver-pro",
      "type": "string"
    },
    {
      "key": "username",
      "value": "superuser",
      "type": "string"
    },
    {
      "key": "password",
      "value": "superuser",
      "type": "string"
    },
    {
      "key": "request_id",
      "value": "",
      "type": "string",
      "description": "Report execution request ID from async execution"
    },
    {
      "key": "export_id",
      "value": "",
      "type": "string",
      "description": "Export ID from reportExecutions endpoint"
    },
    {
      "key": "job_id",
