            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Daily Sales Report\",\n  \"source\": {\n    \"reportUnitURI\": \"/reports/foodmart/top_5_customers_revenue\",\n    \"parameters\": {}\n  },\n  \"trigger\": {\n    \"simpleTrigger\": {\n      \"timezone\": \"America/Chicago\",\n      \"startType\": 1,\n      \"occurrenceCount\": -1,\n      \"recurrenceInterval\": 1,\n      \"recurrenceIntervalUnit\": \"DAY\"\n    }\n  },\n  \"baseOutputFilename\": \"top_5_customers\",\n  \"outputFormats\": {\n    \"outputFormat\": [\"PDF\", \"XLSX\"]\n  },\n  \"repositoryDestination\": {\n    \"folderURI\": \"/reports/foodmart\",\n    \"saveToRepository\": true,\n    \"overwriteFiles\": true\n  },\n  \"mailNotification\": {\n    \"toAddresses\": \"ops@example.com\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/rest_v2/jobs",
              "host": ["{{base_url}}"],
              "path": ["rest_v2", "jobs"]
            },
            "description": "Create a new scheduled job. startType: 1=now, 2=at startDate. occurrenceCount: 1=once, -1=forever"
