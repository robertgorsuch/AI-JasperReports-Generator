    {
      "name": "Jobs - Scheduling",
      "item": [
        {
          "name": "Create Job",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/job+json"
              },
              {
                "key": "Accept",
                "value": "application/job+json"
